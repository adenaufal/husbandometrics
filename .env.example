# Copy to .env.local and fill in what you have. Every value is optional:
# without a token a fetcher falls back to a deterministic synthetic score, and
# without a database the API recomputes rankings on each cache miss.

# --- Server ---
PORT=3001
# Set to true to skip the weekly cron refresh (useful in dev).
DISABLE_JOBS=false
# When set, POST /api/rankings/refresh requires this value in x-refresh-token.
REFRESH_TOKEN=

# --- Frontend ---
# Where the board is read from. Defaults to /rankings.json, the file written by
# `npm run snapshot` and committed by the weekly job. Set to /api/rankings to
# develop against a running server instead (vite proxies it to PORT above).
VITE_RANKINGS_URL=

# --- Database (optional) ---
# turso | planetscale | none
DATABASE_PROVIDER=none
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PLANETSCALE_URL=

# --- Cache (optional; falls back to in-process memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=21600

# --- Data sources ---
# Every source works without credentials. AniList and Jikan (MyAnimeList) need
# no key at all; AO3 and Danbooru are read anonymously.
AO3_BASE_URL=https://archiveofourown.org
# Optional: raises Danbooru's rate limit, not required.
DANBOORU_API_KEY=
FETCH_TIMEOUT_MS=15000
# How many anime/manga characters to pull from AniList's favourites board.
# The curated game roster in server/data/gameRoster.ts is added on top.
# A refresh costs roughly 5.5s per character, nearly all of it AO3 pacing.
ANIME_ROSTER_SIZE=90

# --- Scoring weights ---
# Applied only to the sources that returned a reading for a character, then
# renormalized across them. A source with no reading is excluded, never zeroed.
WEIGHT_ANILIST=0.35
WEIGHT_MAL=0.25
WEIGHT_AO3=0.2
WEIGHT_DANBOORU=0.2
